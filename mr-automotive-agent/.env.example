# Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# PolarGrid AI API (OpenAI-compatible)
POLARGRID_API_KEY=pg_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POLARGRID_REGION=yto-01

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notification recipients (comma-separated)
SMS_RECIPIENTS=+1xxxxxxxxxx,+1xxxxxxxxxx
EMAIL_RECIPIENTS=you@example.com,other@example.com

# Server
PORT=3000

# Public URL of this server (used for WebSocket in TwiML)
# For local dev: use ngrok URL, e.g. https://abc123.ngrok.io
# For production: your Railway/Fly.io/etc URL
PUBLIC_URL=https://your-server.example.com
